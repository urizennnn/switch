#!/bin/sh
# Run Switch from this checkout, rebuilding it first when its sources changed.
# Tests are not part of the binary, so editing them never triggers a rebuild.
# Install: ln -s "$PWD/scripts/switch" ~/.local/bin/switch
set -e

script=$(readlink -f "$0")
repo=$(cd "$(dirname "$script")/.." && pwd)
bin="$repo/switch"

# A folder newer than the binary gained or lost a file, such as a deleted .go
# file. The root folder is left out, since building the binary updates it, and
# so are dot folders like .git and .switch, which hold no Go packages.
if [ ! -x "$bin" ] || [ -n "$(find "$repo" -path "$repo/.*" -prune -o \( \( -name '*.go' ! -name '*_test.go' \) -o -name go.mod -o -name go.sum -o \( -type d ! -path "$repo" \) \) -newer "$bin" -print -quit)" ]; then
	echo "switch: building…" >&2
	go -C "$repo" build -o "$bin" . || { echo "switch: build failed" >&2; exit 1; }
fi

# Run in the caller's directory: Switch works on the project you are in.
exec "$bin" "$@"
